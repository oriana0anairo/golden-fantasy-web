# ---------------------------------------------------------------------------
# Golden Fantasy — variables de entorno del frontend
# Copiar a .env.local para desarrollo. En Vercel, definirlas en el dashboard.
# ---------------------------------------------------------------------------

# URL base del backend (repo golden-fantasy-backend, desplegado en Render).
# Solo se lee del lado del servidor — nunca se expone al navegador.
BACKEND_API_URL=https://golden-fantasy-api.onrender.com

# Secreto para firmar las cookies/JWT de sesión de NextAuth.
# Generar uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública de esta app. En local: http://localhost:3000
# En Vercel: https://<tu-proyecto>.vercel.app
#
# OJO: no la dejes definida y vacía. NextAuth hace new URL() con este valor al
# cargar; una cadena vacía lanza "TypeError: Invalid URL" y tumba el build.
# Si no la vas a usar, bórrala en vez de dejarla en blanco.
NEXTAUTH_URL=http://localhost:3000

# Hosts extra desde los que `next/image` puede optimizar fotos de producto
# (el host de BACKEND_API_URL ya se permite solo). Separados por comas.
# Ej. para Supabase Storage: IMAGE_HOSTS=xxxx.supabase.co
# Si el backend devuelve rutas relativas (/uploads/...), déjalo vacío.
IMAGE_HOSTS=
