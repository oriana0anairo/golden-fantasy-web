# ---------------------------------------------------------------------------
# Golden Fantasy — variables de entorno del frontend
# Copiar a .env.local para desarrollo. En Vercel, definirlas en el dashboard.
# ---------------------------------------------------------------------------

# URL base del backend (repo golden-fantasy-backend, desplegado en Render).
# Solo se lee del lado del servidor — nunca se expone al navegador.
BACKEND_API_URL=https://golden-fantasy-api.onrender.com

# Secreto para firmar las cookies/JWT de sesión de NextAuth.
# Generar uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública de esta app. En local: http://localhost:3000
# En Vercel: https://<tu-proyecto>.vercel.app
NEXTAUTH_URL=http://localhost:3000
